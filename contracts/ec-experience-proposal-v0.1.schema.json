{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eidos:ec-experience-proposal:0.1.0",
  "title": "EcExperienceProposalV010",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "proposalId",
    "producedAt",
    "composition",
    "context"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "producedAt": {
      "type": "string"
    },
    "composition": {
      "type": "object",
      "required": [
        "contractVersion",
        "experienceId",
        "regions"
      ],
      "properties": {
        "contractVersion": {
          "const": "0.1.0"
        },
        "experienceId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability",
              "stability"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "stability": {
                "enum": [
                  "invariant",
                  "shared-stable",
                  "personal-stable",
                  "adaptive"
                ]
              },
              "attention": {
                "type": "object"
              },
              "motion": {
                "type": "object"
              },
              "props": {
                "type": "object"
              }
            }
          }
        },
        "constraints": {
          "type": "array"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "contractVersion",
        "contextId",
        "mode",
        "device"
      ],
      "properties": {
        "contractVersion": {
          "const": "0.1.0"
        },
        "contextId": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "standard",
            "role",
            "personal",
            "shared"
          ]
        },
        "role": {
          "type": "string"
        },
        "expertise": {
          "enum": [
            "novice",
            "intermediate",
            "expert"
          ]
        },
        "task": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "device": {
          "type": "object",
          "required": [
            "terminal"
          ],
          "properties": {
            "terminal": {
              "enum": [
                "web",
                "desktop",
                "mobile",
                "tablet",
                "large-screen",
                "embedded",
                "terminal",
                "voice",
                "agent"
              ]
            }
          }
        },
        "preferences": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "adaptation": {
      "type": "object"
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "explanation"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
