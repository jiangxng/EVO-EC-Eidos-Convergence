{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ec:enterprise-function-pack:0.1.0",
  "title": "EnterpriseFunctionPackManifestV010",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "packId",
    "name",
    "version",
    "function",
    "createdAt",
    "sourceEcVersion",
    "dependencies",
    "files",
    "compatibility"
