      "const": "0.1.0"
    },
    "packId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "function": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "sourceEcVersion": {
      "type": "string"
    },
    "dependencies": {
      "type": "array"
    },
    "files": {
      "type": "array"
    },
    "compatibility": {
      "type": "object"
    }
  }
